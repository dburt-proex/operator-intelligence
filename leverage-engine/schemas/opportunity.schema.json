{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "opportunity.schema.json",
  "title": "Leverage Engine Opportunity",
  "description": "Evidence-backed candidate with explicit score inputs and policy state.",
  "type": "object",
  "required": ["opportunity_id", "objective", "opportunity_type", "supporting_signals", "target_assets", "dependencies", "duplicates", "expected_outcome", "success_evidence", "score_inputs", "raw_value_score", "friction_score", "risk_score", "confidence", "confidence_factor", "evidence_quality", "urgency_bonus", "verified_deadline", "leverage_index", "boundary_flags", "gate_result", "gate_reasons", "state", "assumptions"],
  "properties": {
    "opportunity_id": {"type": "string", "pattern": "^LE-OPP-[0-9]{4}-[0-9]{4}$"},
    "objective": {"type": "string", "minLength": 1},
    "opportunity_type": {"enum": ["revenue", "career", "product", "portfolio", "maintenance", "evidence", "risk_reduction"]},
    "supporting_signals": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "target_assets": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "dependencies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "duplicates": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "expected_outcome": {"type": "string", "minLength": 1},
    "success_evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "score_inputs": {"type": "object"},
    "raw_value_score": {"type": "number", "minimum": 0, "maximum": 100},
    "friction_score": {"type": "number", "minimum": 0, "maximum": 100},
    "risk_score": {"type": "number", "minimum": 0, "maximum": 100},
    "confidence": {"enum": ["high", "medium", "low", "unknown"]},
    "confidence_factor": {"type": "number", "minimum": 0, "maximum": 1},
    "evidence_quality": {"type": "number", "minimum": 0, "maximum": 100},
    "urgency_bonus": {"type": "number", "minimum": 0, "maximum": 10},
    "verified_deadline": {"type": ["string", "null"]},
    "leverage_index": {"type": "number", "minimum": 0, "maximum": 100},
    "boundary_flags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "gate_result": {"enum": ["ALLOW", "REVIEW", "HALT"]},
    "gate_reasons": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "state": {"enum": ["discovered", "validating", "scored", "selected", "watchlist", "review", "blocked", "expired", "superseded", "duplicate"]},
    "assumptions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  },
  "additionalProperties": false
}
