{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "signal.schema.json",
  "title": "Leverage Engine Signal",
  "description": "Provenance-preserving normalized signal for advisory prioritization.",
  "type": "object",
  "required": ["signal_id", "source_id", "source_type", "observed_at", "retrieved_at", "title", "summary", "evidence_refs", "affected_assets", "freshness_state", "evidence_quality", "confidence", "validation_state"],
  "properties": {
    "signal_id": {"type": "string", "pattern": "^LE-SIG-[0-9]{4}-[0-9]{4}$"},
    "source_id": {"type": "string", "minLength": 1},
    "source_type": {"enum": ["news", "funding", "hiring", "enterprise_adoption", "startup", "github", "repository", "user_directive"]},
    "observed_at": {"type": "string", "format": "date-time"},
    "retrieved_at": {"type": "string", "format": "date-time"},
    "title": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "affected_assets": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "freshness_state": {"enum": ["current", "aging", "stale", "unknown"]},
    "evidence_quality": {"type": "number", "minimum": 0, "maximum": 100},
    "confidence": {"enum": ["high", "medium", "low", "unknown"]},
    "validation_state": {"enum": ["validated", "validation_required", "contradicted", "blocked"]},
    "untrusted_instruction_detected": {"type": "boolean"}
  },
  "additionalProperties": false
}
