{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "repository-state.schema.json",
  "title": "Leverage Engine Repository State",
  "description": "Read-only repository snapshot tied to an immutable commit SHA.",
  "type": "object",
  "required": ["snapshot_id", "repository_id", "canonical_ref", "commit_sha", "captured_at", "inspection_scope", "unfinished_items", "blocked_items", "duplicate_candidates", "stale_candidates", "evidence_gaps", "commercial_assets", "routing_restrictions"],
  "properties": {
    "snapshot_id": {"type": "string", "pattern": "^LE-REP-[0-9]{4}-[0-9]{4}$"},
    "repository_id": {"type": "string", "minLength": 1},
    "canonical_ref": {"type": "string", "minLength": 1},
    "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"},
    "captured_at": {"type": "string", "format": "date-time"},
    "inspection_scope": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "unfinished_items": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "blocked_items": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "duplicate_candidates": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "stale_candidates": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "evidence_gaps": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "commercial_assets": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "routing_restrictions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  },
  "additionalProperties": false
}
