{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "improvement-patterns.schema.json",
  "title": "Leverage Engine Improvement Pattern Registry",
  "description": "Versioned explicit lexical patterns that map retained friction/failure/risk signals to bounded infrastructure-improvement categories without semantic guessing.",
  "type": "object",
  "required": ["version", "patterns"],
  "properties": {
    "version": {"type": "string", "minLength": 1},
    "patterns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "pattern_id",
          "category",
          "match_any",
          "objective",
          "proposed_action",
          "expected_leverage",
          "scope",
          "not_in_scope"
        ],
        "properties": {
          "pattern_id": {"type": "string", "minLength": 1},
          "category": {"type": "string", "minLength": 1},
          "match_any": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "objective": {"type": "string", "minLength": 1},
          "proposed_action": {"type": "string", "minLength": 1},
          "expected_leverage": {"enum": ["low", "medium", "high", "unknown"]},
          "scope": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "not_in_scope": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
