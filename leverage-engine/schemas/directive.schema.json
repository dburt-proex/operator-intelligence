{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "directive.schema.json",
  "title": "Leverage Directive",
  "description": "Bounded, expiring, human-reviewed advisory action contract.",
  "type": "object",
  "required": ["directive_id", "run_id", "selected_opportunity_id", "objective", "target_system", "proposed_action", "evidence_refs", "score_summary", "assumptions", "dependencies", "allowed_actions", "prohibited_actions", "review_owner", "approval_state", "expires_at", "expected_outcome", "completion_evidence", "rollback_or_recovery", "ledger_record_id"],
  "properties": {
    "directive_id": {"type": "string", "pattern": "^LD-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{3}$"},
    "run_id": {"type": "string", "pattern": "^LE-RUN-[0-9]{4}-[0-9]{4}$"},
    "selected_opportunity_id": {"type": "string", "pattern": "^LE-OPP-[0-9]{4}-[0-9]{4}$"},
    "objective": {"type": "string", "minLength": 1},
    "target_system": {"type": "string", "minLength": 1},
    "proposed_action": {"type": "string", "minLength": 1},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "score_summary": {"type": "object"},
    "assumptions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "dependencies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "allowed_actions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "prohibited_actions": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "review_owner": {"type": "string", "minLength": 1},
    "approval_state": {"enum": ["draft", "approved", "rejected", "expired"]},
    "expires_at": {"type": "string", "format": "date-time"},
    "expected_outcome": {"type": "string", "minLength": 1},
    "completion_evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "rollback_or_recovery": {"type": "string", "minLength": 1},
    "ledger_record_id": {"type": "string", "pattern": "^LE-LED-[a-f0-9]{16}$"}
  },
  "additionalProperties": false
}
