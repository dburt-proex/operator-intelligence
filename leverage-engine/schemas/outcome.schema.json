{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "outcome.schema.json",
  "title": "Leverage Engine Outcome",
  "description": "Human-reviewed distinction between completion evidence and realized value.",
  "type": "object",
  "required": ["outcome_id", "directive_id", "completion_state", "observed_results", "expected_vs_actual", "realized_value_state", "lesson", "future_priority_effect", "reviewed_by", "reviewed_at"],
  "properties": {
    "outcome_id": {"type": "string", "pattern": "^LE-OUT-[0-9]{4}-[0-9]{4}$"},
    "directive_id": {"type": "string", "pattern": "^LD-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{3}$"},
    "completion_state": {"enum": ["completed", "partial", "blocked", "failed", "abandoned"]},
    "observed_results": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "expected_vs_actual": {"type": "string"},
    "realized_value_state": {"enum": ["verified", "partially_verified", "unverified", "disproven"]},
    "lesson": {"type": "string"},
    "future_priority_effect": {"enum": ["none", "raise", "lower", "suppress_duplicate"]},
    "reviewed_by": {"type": "string", "minLength": 1},
    "reviewed_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
